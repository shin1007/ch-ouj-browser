{
  "manifest_version": 3,
  "name": "放送大学授業ブラウザ",
  "version": "2026.7.18",
  "description": "放送大学の放送授業での学習を便利にする拡張機能",
  "author": "shin1007",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation" 
  ],
  "host_permissions": [
    "https://v.ouj.ac.jp/*",
    "https://sso.ouj.ac.jp/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ouj.ac.jp/*"
      ],
      "css": [
        "utils/dark-mode.css"
      ],
      "js": [
        "utils/dark-mode.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://v.ouj.ac.jp/*"
      ],
      "js": [
        "page-size-patch.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.ouj.ac.jp/*"
      ],
      "css": [
        "thumbnail-progress.css",
        "page-video/video-subtitle-size.css"
      ],
      "js": [
        "utils/net.js",
        "utils/dom-wait.js",
        "utils/settings.js",
        "utils/display-options.js",
        "utils/notification.js",
        "utils/dialog.js",
        "utils/text.js",
        "utils/page-type.js",
        "utils/favorites-helper.js",
        "utils/viewingStatus.js",
        "utils/progress-badge.js",
        "utils/watch-later.js",
        "utils/breadcrumbs.js",
        "utils/categories.js",
        "utils/year.js",
        "utils/goToLoginPage.js",
        "utils/login-state.js",
        "utils/thumbnail-progress.js",
        "utils/study-time.js",
        "menu/menu-native-shell.js",
        "menu/menu-favorites.js",
        "menu/menu-history.js",
        "menu/menu-recommendation.js",
        "menu/menu-recommendation-panel.js",
        "menu/menu-study-time.js",
        "menu/menu-watch-later.js",
        "menu/menu-bookmarks.js",
        "menu/menu-whats-new.js",
        "menu/menu-display-options.js",
        "menu/menu.js",
        "menu/menu-header-darkmode.js",
        "menu/menu-header-collapse.js",
        "menu/menu-header-wakaba.js",
        "page-video/video-ending.js",
        "page-video/video-wake-lock.js",
        "page-video/video-sleep-timer.js",
        "page-video/video-volume-normalization.js",
        "page-video/video-media-session.js",
        "page-video/video-ab-repeat.js",
        "page-video/video-player-actions.js",
        "page-video/video-playback-management.js",
        "page-video/video-player-core.js",
        "page-video/video-prev-next.js",
        "page-video/video-episode-list.js",
        "page-video/video-radio-detection.js",
        "page-video/video-settings.js",
        "page-video/video-show-subtitle.js",
        "page-video/video-subtitle-size.js",
        "page-login.js",
        "page-course-select.js",
        "page-course-select-progress.js",
        "page-course-select-filters.js",
        "page-search-result-filters.js",
        "page-search-result-filter-bar.js",
        "page-search-result-compact.js",
        "page-search-result-autoload.js",
        "search-box-filter-panel.js",
        "search-box-all-subjects-panel.js",
        "page-video-select.js",
        "page-home-continue.js",
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "options_page": "popup/popup.html",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://v.ouj.ac.jp/*"
      ]
    }
  ]
}