[{"createdDate":"2022-03-17T16:52:54.367+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31761,"categoryId":30211,"title":"第01回 生体と恒常性","published":true,"summary":"生命は細胞によってできており、細胞が生命活動を行うためには、体内を適切な環境に調節する必要がある。この回では、細胞の構造と機能ついて解説するとともに、体内環境を適切に保つ生体恒常性について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n関根　紀子(放送大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"1","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":34518,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:52:59.137+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31762,"categoryId":30211,"title":"第02回 栄養とエネルギー代謝","published":true,"summary":"摂取した栄養素は、生命維持や運動のためのエネルギーとして利用される。この回では、生命活動の直接的なエネルギーであるアデノシン三リン酸の合成経路、およびエネルギー供給系について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n関根　紀子(放送大学教授)","detailRichTextMode":false,"point":0,"spotPrice":0,"remarks":"","remarksRichTextMode":false,"uploadStatus":0,"uploadFileName":"(未設定)","uploadFileSize":0,"publishedOpen":false,"alias":"2","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"reviewAmount":0,"reviewUserCount":0,"viewingCount":18709,"reviewAverage":0.0,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:03.633+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31763,"categoryId":30211,"title":"第03回 骨格筋の構造と働き","published":true,"summary":"歩く、走るなどの多くの身体活動は、関節に付着する筋活動によって行われる。この回では、運動に携わる骨格筋の基本的な構造とその働き、および筋肥大と筋萎縮について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n関根　紀子(放送大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"3","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":15963,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:07.990+09:00","updatedDate":"2024-05-15T17:34:18.743+09:00","contentId":31764,"categoryId":30211,"title":"第04回 神経系の構造と働き","published":true,"summary":"脳や脊髄からの命令が神経線維を伝わり筋に到達することで運動は行われ、調節される。この回では、神経系の構造と機能、および運動に対する神経系の役割などについて概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n関根　紀子(放送大学教授)","detailRichTextMode":false,"point":0,"spotPrice":0,"remarks":"","remarksRichTextMode":false,"uploadStatus":0,"uploadFileName":"(未設定)","uploadFileSize":0,"publishedOpen":false,"alias":"4","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"reviewAmount":0,"reviewUserCount":0,"viewingCount":14841,"reviewAverage":0.0,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:12.373+09:00","updatedDate":"2024-08-22T14:58:26.064+09:00","contentId":31765,"categoryId":30211,"title":"第05回 呼吸器系の構造と働き","published":true,"summary":"ヒトは、酸素を身体に取り入れることでエネルギーを得るとともに、生じた二酸化炭素を排出している。この回では、呼吸器系の構造と機能、および運動への適応について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n関根　紀子(放送大学教授)","detailRichTextMode":false,"point":0,"spotPrice":0,"remarks":"","remarksRichTextMode":false,"uploadStatus":0,"uploadFileName":"(未設定)","uploadFileSize":0,"publishedOpen":false,"alias":"5","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"reviewAmount":0,"reviewUserCount":0,"viewingCount":12747,"reviewAverage":0.0,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:17.120+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31766,"categoryId":30211,"title":"第06回 循環器系の構造と働き","published":true,"summary":"呼吸によって身体へ取り入れた酸素は、血液を介して心臓から全身に送られる。この回では、循環器系の構造と機能、および運動への適応について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n関根　紀子(放送大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"6","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":11828,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:21.329+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31767,"categoryId":30211,"title":"第07回 運動と環境","published":true,"summary":"運動は様々な環境において行われる。この回では、特に、暑熱や寒冷、水中、そして、高地環境における運動時の生理学的応答や適応について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n内丸　仁(仙台大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"7","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":10898,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:25.609+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31768,"categoryId":30211,"title":"第08回 トレーニングの計画と実際1","published":true,"summary":"一般人からアスリートまでの幅広い対象者のトレーニングは安全かつ効果的に行う必要がある。この回では、トレーニングの原理・原則、およびトレーニング実施上の注意点について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n内丸　仁(仙台大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"8","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":10811,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:29.971+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31769,"categoryId":30211,"title":"第09回 トレーニングの計画と実際2","published":true,"summary":"トレーニングは目的に応じて適切なトレーニングを計画・実施しなければならない。この回では、体力要素別に各種トレーニングについて概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n内丸　仁(仙台大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"9","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":9484,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:34.349+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31770,"categoryId":30211,"title":"第10回 運動と発育・発達","published":true,"summary":"成人期以前のからだは生涯を通じて最も成長する。運動遊びを含む運動・スポーツ環境は子どもの成長にどのような影響を及ぼしているのだろうか。この回では、子どもの健全な発育発達を促す身体活動の在り方について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n鈴木　宏哉(順天堂大学准教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"10","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":8816,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:39.059+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31771,"categoryId":30211,"title":"第11回 子どもの体力・運動能力","published":true,"summary":"過去と現在の比較、諸外国との相違を通して日本の子どもの体力・運動能力の現状について解説するとともに、何が違いに影響を及ぼしているのか、そして子どもにおける体力・運動能力の意義について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n鈴木　宏哉(順天堂大学准教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"11","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":8240,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:44.006+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31772,"categoryId":30211,"title":"第12回 障害者とスポーツ","published":true,"summary":"障害の有無に関わらず、日常的に運動やスポーツに親しむことは、生涯にわたり健康で豊かな生活を営む上で重要である。この回では、障害のある人たちとスポーツとの関わりについての現状と課題を学ぶ。また、パラリンピックをはじめとする障害者スポーツの競技大会等を紹介し、それらが障害のある人たちや社会にもたらす影響について概説する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n渡邉　貴裕(順天堂大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"12","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":7770,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:50.080+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31773,"categoryId":30211,"title":"第13回 特別支援教育と学校体育","published":true,"summary":"学校体育の充実は生涯スポーツへの発展に大きな役割を果たす。障害がある子どもの体育・健康に関する指導は、特別支援教育の制度下において、教育課程全体を通じて行われている。この回では、特別支援学校（知的障害）の保健体育科の目標や指導内容、指導計画等を概説し、障害のある子どもへの体育・スポーツ指導の実際について理解することを目指す。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n渡邉　貴裕(順天堂大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"13","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":7744,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:55.472+09:00","updatedDate":"2022-04-01T08:03:04.876+09:00","contentId":31774,"categoryId":30211,"title":"第14回 生活習慣病と運動","published":true,"summary":"身体活動量の低下が多くの生活習慣病のリスクとなり、死亡率を上昇させる。年齢に応じて、運動や生活活動を増やすことが、全身持久力を向上し、死亡率や生活習慣病予防につながることを理解する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n小林　裕幸(筑波大学教授)","point":0,"spotPrice":0,"publishedOpen":false,"alias":"14","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"viewingCount":9142,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700},{"createdDate":"2022-03-17T16:53:59.967+09:00","updatedDate":"2024-04-30T17:29:38.452+09:00","contentId":31775,"categoryId":30211,"title":"第15回 運動処方","published":true,"summary":"安全に身体活動を実施する上で、留意すべき症状、疾患、状態、環境などをふまえ、勧められる身体活動を理解し、推奨される身体活動の頻度、強度、時間、種類、活動量、漸進性すなわち運動処方(FITT-VP)を理解する。","detail":"運動と健康（’２２）\n関根　紀子（放送大学教授）\n小林　裕幸(筑波大学教授)","detailRichTextMode":false,"point":0,"spotPrice":0,"remarks":"","remarksRichTextMode":false,"uploadStatus":0,"uploadFileName":"(未設定)","uploadFileSize":0,"publishedOpen":false,"alias":"15","pdfStatus":0,"pdfChapterStatus":0,"enableVR360Degree":false,"pickup":false,"availableDays":7,"fileType":"mp4","popUpTime":0.0,"showPopUp":false,"reviewAmount":0,"reviewUserCount":0,"viewingCount":8473,"reviewAverage":0.0,"expirationDate":"2026-08-07T16:25:35.343+09:00","contentType":"V","tenantId":1,"groupIds":[2,343],"enableWatermark":false,"duration":2700}]